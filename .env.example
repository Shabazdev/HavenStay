# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MongoDB Database Connection
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/havenly_rentals?retryWrites=true&w=majority"
MONGODB_URI=""

# Better Auth (email/password authentication)
# BETTER_AUTH_SECRET: At least 32 chars of high entropy. Required in production.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="REPLACE_WITH_A_BETTER_AUTH_SECRET_AT_LEAST_32_CHARS"
# BETTER_AUTH_URL: Public base URL of the app (cookie domain/sameSite origin).
# In production (Vercel) set this to the deployed URL, e.g. https://haven-stay-ten.vercel.app
# If unset in a Vercel deployment, it is derived from VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL automatically.
BETTER_AUTH_URL="http://localhost:3000"
# TRUSTED_ORIGINS: optional comma-separated extra origins Better Auth should
# accept (custom domains, Vercel preview/branch deployment URLs). Example:
# TRUSTED_ORIGINS="https://havenstay.example.com,https://haven-stay-git-feature.vercel.app"
TRUSTED_ORIGINS=""
# Optional bootstrap admin. If BETTER_AUTH_ADMIN_EMAIL is set together with
# BETTER_AUTH_ADMIN_PASSWORD and no account exists for that email, the admin
# account is created automatically on server start with the 'admin' role
# (assigned server-side only). Leave empty to disable.
BETTER_AUTH_ADMIN_EMAIL=""
BETTER_AUTH_ADMIN_PASSWORD=""

# Stripe Payment Keys
STRIPE_SECRET_KEY="sk_test_51...your_stripe_secret_key"
VITE_STRIPE_PUBLIC_KEY="pk_test_51...your_stripe_public_key"

# Google OAuth Client Credentials (reserved for future real OAuth flow)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Server Configuration
PORT=3000
NODE_ENV="development"
