{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && esbuild serverless-entry.ts --bundle --platform=node --format=cjs --packages=external --outfile=api/index.cjs",
  "outputDirectory": "dist",
  "functions": {
    "api/index.cjs": {
      "bodyParser": false,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

